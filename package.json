{
    "name": "pulse-buddy",
    "version": "1.0.12",
    "description": "Desktop buddy that walks onto your screen to remind you of anything",
    "main": "main.js",
    "author": "you",
    "scripts": {
        "start": "electron .",
        "test": "mocha src/tests/**/*.test.js",
        "build": "node -e \"require('fs').copyFileSync('src/shared/core.js', 'www/core.js')\" && esbuild buddy3d.js --bundle --outfile=www/bundle.js --global-name=Buddy3D",
        "dist": "electron-builder --win"
    },
    "devDependencies": {
        "acorn": "^8.19.0",
        "chai": "^6.3.0",
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3",
        "esbuild": "^0.28.2",
        "mocha": "^12.0.3",
        "puppeteer": "^25.12.0"
    },
    "build": {
        "appId": "com.pulse.buddy",
        "productName": "Pulse Buddy",
        "win": {
            "target": "nsis",
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "artifactName": "Pulse-Buddy-Setup.${ext}"
        },
        "mac": {
            "target": "dmg",
            "icon": "build/icon.png"
        },
        "dmg": {
            "artifactName": "Pulse-Buddy-Mac.${ext}"
        },
        "asar": true
    },
    "dependencies": {
        "@capacitor/android": "^8.5.3",
        "@capacitor/cli": "^8.5.3",
        "@capacitor/core": "^8.5.3",
        "@capacitor/ios": "^8.5.3",
        "@capacitor/local-notifications": "^8.3.1",
        "three": "^0.186.1",
        "three-stdlib": "^2.36.1"
    }
}
