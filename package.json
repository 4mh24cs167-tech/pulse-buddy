{
  "name": "pulse-buddy",
  "version": "1.0.1",
  "description": "Desktop buddy that walks onto your screen to remind you of anything",
  "main": "main.js",
  "author": "you",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pulse.buddy",
    "productName": "Pulse Buddy",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pulse-Buddy-Setup.${ext}"
    }
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}