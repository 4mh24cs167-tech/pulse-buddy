{
  "name": "pulse-buddy",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse Buddy - Avatar Reminder Companion Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:desktop": "concurrently -k \"npm run dev --workspace=apps/web\" \"npm run dev:electron --workspace=apps/desktop\"",
    "build": "npm run build --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:all": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:win": "npm run package:win --workspace=apps/desktop",
    "package:mac": "npm run package:mac --workspace=apps/desktop"
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.7"
  }
}
